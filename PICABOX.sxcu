{
  "Version": "17.0.0",
  "Name": "PICABOX.RU",
  "DestinationType": "ImageUploader",
  "RequestMethod": "POST",
  "RequestURL": "http://picabox.ru/image/upload",
  "Headers": {
    "User-Agent": "ShareX/17.0.0"
  },
  "Body": "MultipartFormData",
  "FileFormName": "ImagesForm[imageFiles][]",
  "Arguments": {
    "ImagesForm[rotate]": "0",
    "ImagesForm[mirror_hor]": "0",
    "ImagesForm[mirror_ver]": "0",
    "ImagesForm[resolution]": "2",
    "ImagesForm[text]": "",
    "ImagesForm[watermark]": "0",
    "ImagesForm[is_gif]": "0"
  },
  "URL": "{json:loaded_pics[0].texts.fileName}",
  "ThumbnailURL": "http://picabox.ru{json:loaded_pics[0].texts.image_small}",
  "DeletionURL": "",
  "ErrorMessage": "{json:error}"
}